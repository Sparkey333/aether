{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ThirdThumb",
  "version": "0.1.0",
  "identifier": "com.darkhearts.thirdthumb",
  "build": {
    "frontendDist": "../dashboard"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ThirdThumb · GhostHands",
        "label": "main",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0a0b10"
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: data: blob:; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "copyright": "© 2026 ThirdThumb",
    "shortDescription": "It mashes, you chill.",
    "longDescription": "ThirdThumb (GhostHands) is a friendly, local-first auto-masher for the long, boring stretches of single-player games — Pokémon shiny hunts, JRPG grinds, idle tappers. Single-player / accessibility first.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
