/out/

# production
/build

# tauri
/src-tauri/target

# generated Loom output (regenerated by the heartbeat)
/public/data/hypotheses.json

# env — secrets never enter the repo.
# The bare-name rules below missed `Aether.env` once and a live key was
# committed; `*.env` is the catch-all so a non-standard name can't slip past
# again. `.env.example` / `.env.assets.example` don't match and stay tracked.
.env*.local
.env
.env.assets
*.env

# generated AI art (rendered locally from public/assets/manifest.json; keep the vector starters, not the binaries)
/public/assets/generated/

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo
next-env.d.ts
