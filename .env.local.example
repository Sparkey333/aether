# Aether environment — copy to .env.local

# The Loom's deeper reasoning layer (optional in v1; the heartbeat runs the
# geometric engine with no key). Add a key to let the Loom narrate hypotheses.
ANTHROPIC_API_KEY=

# Optional: a MapTiler / Stadia key if you swap the basemap from the
# no-key Carto/OSM raster tiles to vector tiles. Leave blank to use defaults.
NEXT_PUBLIC_MAP_TILE_KEY=

# ── The Grove — image generation (scripts/imagine.mjs) ───────────────────
# Nano Banana (Google Gemini image). Get one at https://aistudio.google.com/apikey
# GOOGLE_API_KEY is also accepted (and takes precedence if both are set).
GEMINI_API_KEY=
# Optional: override the default image model (gemini-2.5-flash-image).
# Other ids: gemini-3-pro-image-preview (Nano Banana Pro), gemini-3.1-flash-image-preview (Nano Banana 2)
GROVE_IMAGE_MODEL=
# Fallback image providers (used only if GEMINI_API_KEY is absent)
OPENAI_API_KEY=
STABILITY_API_KEY=
