# The writers' room is optional. The Loom runs zero-dep on its template engine
# without any of this. To give the Foundling a real voice:
#
#   cd mirth && npm install && cp .env.example .env && $EDITOR .env
#
# then `set -a; . ./.env; set +a` (or export these) before `npm run pulse`.

# Required to open the writers' room.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — defaults to claude-opus-4-8 (the most capable Opus-tier model).
# MIRTH_MODEL=claude-opus-4-8
