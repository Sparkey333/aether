# Copy to .env (gitignored) and fill in only the providers you actually have
# accounts for. Never commit real keys; never paste them in chat with an AI
# assistant — an assistant has no way to store a secret more safely than a
# local .env file the tools already read from.
#
# Every provider below is optional. Nothing reads these except the matching
# adapter in providers/*.mjs, and every adapter fails loudly (naming the
# exact env var) rather than silently if its key is missing — the pipeline
# never fabricates a "successful" generation.

# --- High confidence / stable public REST APIs -----------------------------

# https://platform.stability.ai/account/keys
STABILITY_API_KEY=

# https://app.leonardo.ai/api-access
LEONARDO_API_KEY=

# https://dev.runwayml.com  (Runway API, separate from the consumer app login)
RUNWAY_API_KEY=

# https://lumalabs.ai/dream-machine/api  (Dream Machine API keys)
LUMA_API_KEY=

# --- Newer / regionally-limited / verify current docs before relying on ----

# https://higgsfield.ai — primarily a consumer app; confirm current developer
# API availability and auth scheme before use (see providers/higgsfield.mjs).
HIGGSFIELD_API_KEY=

# Kling AI's official API is region-gated (Kuaishou); most western developers
# reach it through a reseller/aggregator (e.g. fal.ai, piapi.ai) rather than
# klingai.com directly. Point KLING_API_BASE at whichever you actually use.
KLING_API_KEY=
KLING_API_BASE=

# Pika Labs' official API has historically trailed its Discord bot; confirm
# it's live and check the current base URL before use.
PIKA_API_KEY=
