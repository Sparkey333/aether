{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bosses.schema.json",
  "title": "Boss configs",
  "type": "object",
  "required": ["bosses"],
  "properties": {
    "version": { "type": "string" },
    "bosses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "hp", "poise", "phases"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" },
          "title": { "type": "string" },
          "tier": { "enum": ["A", "B", "C", "D"] },
          "hp": { "type": "integer", "minimum": 1 },
          "poise": { "type": "integer", "minimum": 0 },
          "poiseRegenPerSec": { "type": "number" },
          "launchable": { "type": "boolean" },
          "moveSpeedMps": { "type": "number" },
          "arena": { "type": "string" },
          "behavior": { "type": "string" },
          "phases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "hpEnterPct", "attacks"],
              "properties": {
                "name": { "type": "string" },
                "hpEnterPct": { "type": "number", "minimum": 0, "maximum": 1 },
                "transitionInFrames": { "type": "integer", "minimum": 0 },
                "moveSpeedMps": { "type": "number" },
                "attacks": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["moveRef", "weight"],
                    "properties": {
                      "moveRef": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                      "weight": { "type": "number", "minimum": 0 },
                      "minRangeM": { "type": "number", "minimum": 0 },
                      "maxRangeM": { "type": "number", "minimum": 0 },
                      "cooldownFrames": { "type": "integer", "minimum": 0 },
                      "punishRecoveryFrames": { "type": "integer", "minimum": 0 },
                      "hardCounter": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "onDeath": { "type": "object" }
        }
      }
    }
  }
}
