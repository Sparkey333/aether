{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "weapons.schema.json",
  "title": "Weapon stat blocks",
  "type": "object",
  "required": ["weapons"],
  "properties": {
    "version": { "type": "string" },
    "weapons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "lightCombo", "heavyCombo"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "lightCombo": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "heavyCombo": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "launcher": { "type": "string" },
          "aerialCombo": { "type": "array", "items": { "type": "string" } },
          "dashAttack": { "type": "string" },
          "damageScalar": { "type": "number", "minimum": 0 },
          "staminaPerSwing": { "type": "number", "minimum": 0 },
          "dodgeStaminaCost": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
