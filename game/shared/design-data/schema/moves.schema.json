{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "moves.schema.json",
  "title": "Move / attack definitions",
  "type": "object",
  "required": ["moves"],
  "properties": {
    "version": { "type": "string" },
    "moves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "frames", "hits"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" },
          "kind": { "enum": ["light", "heavy", "launcher", "aerial", "special", "grab", "critical"] },
          "staminaCost": { "type": "number", "minimum": 0 },
          "aetherCost": { "type": "number", "minimum": 0 },
          "frames": {
            "type": "object",
            "required": ["total", "active"],
            "properties": {
              "total": { "type": "integer", "minimum": 1 },
              "startup": { "type": "integer", "minimum": 0 },
              "active": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
              "recovery": { "type": "integer", "minimum": 0 },
              "iframes": { "type": "array", "items": { "type": "integer" } },
              "hyperArmorFrom": { "type": "integer" }
            }
          },
          "hits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["damage", "poiseDamage", "hitstop", "hitbox"],
              "properties": {
                "damage": { "type": "integer", "minimum": 0 },
                "poiseDamage": { "type": "integer", "minimum": 0 },
                "hitstop": { "type": "integer", "minimum": 0 },
                "knockback": { "type": "number" },
                "launch": { "type": "boolean" },
                "guardBreak": { "type": "boolean" },
                "unparryable": { "type": "boolean" },
                "projectile": { "type": "boolean" },
                "hardCounter": { "type": "string" },
                "hitbox": {
                  "type": "object",
                  "required": ["shape", "radius", "offset"],
                  "properties": {
                    "shape": { "enum": ["sphere", "capsule"] },
                    "radius": { "type": "number", "minimum": 0 },
                    "length": { "type": "number", "minimum": 0 },
                    "offset": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 }
                  }
                }
              }
            }
          },
          "comboNext": { "type": "array", "items": { "type": "string" } },
          "flowMoveId": { "type": "string" }
        }
      }
    }
  }
}
