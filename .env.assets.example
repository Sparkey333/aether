# Aether Fight — asset-generation keys. Copy to .env.assets and fill what you have.
# Load before running, e.g.:  set -a && . ./.env.assets && set +a && npm run assets:generate
# (.env.assets is gitignored — never commit real keys.)

# --- Images ---
# Google Gemini / Imagen  (https://aistudio.google.com/apikey)  ← your primary
GEMINI_API_KEY=
# image model: "gemini-2.5-flash-image" (a.k.a. Nano Banana, best for character consistency)
# or an Imagen model like "imagen-3.0-generate-002" / "imagen-4.0-generate-001"
GEMINI_MODEL=gemini-2.5-flash-image

# OpenAI gpt-image-1 (fallback)            https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Replicate (Flux 1.1 Pro, fallback)       https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Stability / Recraft (optional)
STABILITY_API_KEY=
RECRAFT_API_KEY=

# Pick the default provider: gemini | openai | replicate
ASSET_PROVIDER=gemini

# --- Recommended for later (no code wired yet; see docs/ASSET_PIPELINE.md) ---
# SCENARIO_API_KEY=        # game sprite sheets / consistent style packs
# BLOCKADE_API_KEY=        # Skybox AI — 360° VR dojo panoramas
# RUNWAY_API_KEY=          # image→video animation loops
# LUMA_API_KEY=            # Dream Machine image→video
# MESHY_API_KEY=           # image→3D weapons/props
# ELEVENLABS_API_KEY=      # SFX / announcer VO
